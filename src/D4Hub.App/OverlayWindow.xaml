<Window x:Class="D4Hub.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:D4Hub.App.Views"
        Title="DHub HUD"
        Width="695"
        Height="1060"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent"
        Topmost="True"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Grid>
        <views:HudOverlayView ProfileName="{Binding CurrentProfileName}"
                              Rules="{Binding CurrentProfile.EquipmentRules}"
                              DisplayMode="{Binding HudDisplayMode}"
                              IsEditing="{Binding IsLayoutEditing}" />
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                Padding="8"
                Background="#F2211F1B"
                BorderBrush="#FF77BBA7"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding IsLayoutEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="布局校准"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" · " Foreground="#FFC6BAA5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LayoutResolutionLabel}"
                               Foreground="#FFC6BAA5"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Button Content="恢复默认"
                            Command="{Binding ResetLayoutCommand}"
                            Style="{StaticResource BaseButton}"
                            MinWidth="72"
                            MinHeight="30"
                            Margin="0,0,6,0" />
                    <Button Content="取消"
                            Command="{Binding CancelLayoutEditingCommand}"
                            Style="{StaticResource BaseButton}"
                            MinWidth="56"
                            MinHeight="30"
                            Margin="0,0,6,0" />
                    <Button Content="保存模板"
                            Command="{Binding SaveLayoutTemplateCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="82"
                            MinHeight="30" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
