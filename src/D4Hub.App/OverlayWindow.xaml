<Window x:Class="D4Hub.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:D4Hub.App.Views"
        Title="DHub HUD"
        Width="695"
        Height="1060"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="True"
        Background="Transparent"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="HudCalibrationSurfaceBrush"
                         Color="{StaticResource ColorSurface}"
                         Opacity="0.96" />
    </Window.Resources>
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <views:HudOverlayView ProfileName="{Binding CurrentProfileName}"
                              Rules="{Binding CurrentProfile.EquipmentRules}"
                              DisplayMode="{Binding HudDisplayMode}"
                              IsEditing="{Binding IsLayoutEditing}" />
        <Border x:Name="CalibrationPanel"
                MaxWidth="360"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="12,0,12,12"
                Padding="10"
                Background="{StaticResource HudCalibrationSurfaceBrush}"
                BorderBrush="{StaticResource SuccessBrush}"
                BorderThickness="1"
                CornerRadius="6"
                RenderTransformOrigin="0.5,0.5"
                Visibility="{Binding IsLayoutEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.RenderTransform>
                <TranslateTransform X="0" Y="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="5" Opacity="0.5" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLayoutEditing}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="布局校准"
                               Foreground="White"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               Text="{Binding LayoutResolutionLabel}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
                <UniformGrid Grid.Row="2" Columns="3">
                    <Button Content="恢复默认"
                            AutomationProperties.Name="恢复默认布局"
                            Command="{Binding ResetLayoutCommand}"
                            Style="{StaticResource BaseButton}"
                            MinHeight="34"
                            Padding="8,0"
                            Margin="0,0,4,0" />
                    <Button Content="取消"
                            AutomationProperties.Name="取消布局调整"
                            Command="{Binding CancelLayoutEditingCommand}"
                            Style="{StaticResource BaseButton}"
                            MinHeight="34"
                            Padding="8,0"
                            Margin="2,0" />
                    <Button Content="保存模板"
                            AutomationProperties.Name="保存布局模板"
                            Command="{Binding SaveLayoutTemplateCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="34"
                            Padding="8,0"
                            Margin="4,0,0,0" />
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
