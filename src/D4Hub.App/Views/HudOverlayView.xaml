<UserControl x:Class="D4Hub.App.Views.HudOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:D4Hub.Core;assembly=D4Hub.Core"
             xmlns:views="clr-namespace:D4Hub.App.Views"
             x:Name="Root"
             IsHitTestVisible="{Binding IsEditing, ElementName=Root}"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="AffixText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCFD5DB" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF000000"
                                      BlurRadius="2.5"
                                      ShadowDepth="1"
                                      Opacity="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Core}">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Offensive}">
                    <Setter Property="Foreground" Value="#FFFF6B5F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Defensive}">
                    <Setter Property="Foreground" Value="#FF69B5FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Utility}">
                    <Setter Property="Foreground" Value="#FF8BE36B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Skill}">
                    <Setter Property="Foreground" Value="#FFFFD45C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueAffixText" TargetType="TextBlock" BasedOn="{StaticResource AffixText}">
            <Setter Property="FontSize" Value="9.75" />
        </Style>

        <Style x:Key="AffixGlowText" TargetType="TextBlock" BasedOn="{StaticResource AffixText}">
            <Setter Property="Opacity" Value="0.88" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFCFD5DB"
                                      BlurRadius="8"
                                      ShadowDepth="0"
                                      Opacity="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Core}">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Offensive}">
                    <Setter Property="Foreground" Value="#FFFF6B5F" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFF5A4E" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Defensive}">
                    <Setter Property="Foreground" Value="#FF69B5FF" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF3A9DFF" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Utility}">
                    <Setter Property="Foreground" Value="#FF8BE36B" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF68D43D" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Skill}">
                    <Setter Property="Foreground" Value="#FFFFD45C" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFFBF2F" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueAffixGlowText" TargetType="TextBlock" BasedOn="{StaticResource AffixGlowText}">
            <Setter Property="FontSize" Value="9.75" />
        </Style>

        <Style x:Key="AffixSourceBadge" TargetType="Border">
            <Setter Property="Height" Value="12" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AffixSourceBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="7.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="AffixSourceIcon" TargetType="Image">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas x:Name="DesignCanvas"
                Width="695"
                Height="1060"
                Background="Transparent"
                MouseMove="DesignCanvas_MouseMove"
                MouseLeftButtonUp="DesignCanvas_MouseLeftButtonUp"
                LostMouseCapture="DesignCanvas_LostMouseCapture">
            <Border Canvas.Left="238"
                    Canvas.Top="12"
                    Width="277"
                    Height="32"
                    Background="#C9171512"
                    BorderBrush="#8C77BBA7"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,0">
                <TextBlock Text="{Binding ProfileName, ElementName=Root}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <ItemsControl ItemsSource="{Binding Rules, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="695" Height="1060" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding AnchorX}" />
                        <Setter Property="Canvas.Top" Value="{Binding AnchorY}" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding DisplayWidth}"
                              Background="Transparent"
                              MouseLeftButtonDown="Rule_MouseLeftButtonDown">
                            <ItemsControl ItemsSource="{Binding DisplayLines}"
                                          Width="{Binding DisplayWidth}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding DataContext.DisplayWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                          Height="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel x:Name="CompactSourceMarkers"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Image Source="/D4Hub;component/Assets/Hud/marker-tempered.png"
                                                   Style="{StaticResource AffixSourceIcon}"
                                                   Visibility="{Binding IsTempered, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Image Source="/D4Hub;component/Assets/Hud/marker-masterworked.png"
                                                   Style="{StaticResource AffixSourceIcon}"
                                                   Visibility="{Binding IsMasterworked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Image Source="/D4Hub;component/Assets/Hud/marker-transfigured.png"
                                                   Style="{StaticResource AffixSourceIcon}"
                                                   Visibility="{Binding IsTransfigured, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel x:Name="ValueSourceBadges"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                            <Border Style="{StaticResource AffixSourceBadge}"
                                                    Background="#B23B2713"
                                                    BorderBrush="#FFFFB454"
                                                    Visibility="{Binding IsTempered, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="回火"
                                                           Foreground="#FFFFC779"
                                                           Style="{StaticResource AffixSourceBadgeText}" />
                                            </Border>
                                            <Border Style="{StaticResource AffixSourceBadge}"
                                                    Background="#B231183C"
                                                    BorderBrush="#FFD6A5FF"
                                                    Visibility="{Binding IsMasterworked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="精造"
                                                           Foreground="#FFE2C2FF"
                                                           Style="{StaticResource AffixSourceBadgeText}" />
                                            </Border>
                                            <Border Style="{StaticResource AffixSourceBadge}"
                                                    Background="#B2103837"
                                                    BorderBrush="#FF5CE1D1"
                                                    Visibility="{Binding IsTransfigured, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="嬗变"
                                                           Foreground="#FF82F2E5"
                                                           Style="{StaticResource AffixSourceBadgeText}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="CompactGlow"
                                                   Grid.Column="0"
                                                   Text="{Binding CompactText}"
                                                   TextAlignment="Left"
                                                   Style="{StaticResource AffixGlowText}" />
                                        <TextBlock x:Name="CompactText"
                                                   Grid.Column="0"
                                                   Text="{Binding CompactText}"
                                                   TextAlignment="Left"
                                                   Style="{StaticResource AffixText}" />
                                        <TextBlock x:Name="ValueGlow"
                                                   Grid.Column="0"
                                                   Text="{Binding ValueText}"
                                                   TextAlignment="Left"
                                                   Style="{StaticResource ValueAffixGlowText}"
                                                   Visibility="Collapsed" />
                                        <TextBlock x:Name="ValueText"
                                                   Grid.Column="0"
                                                   Text="{Binding ValueText}"
                                                   TextAlignment="Left"
                                                   Style="{StaticResource ValueAffixText}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type views:HudOverlayView}}}"
                                                     Value="{x:Static core:HudDisplayMode.Values}">
                                            <Setter TargetName="CompactSourceMarkers" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ValueSourceBadges" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="CompactText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="CompactGlow" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ValueText" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ValueGlow" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="EditFrame"
                                    Margin="-5"
                                    Background="#20211F1B"
                                    BorderBrush="#FF77BBA7"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-17,-1,0"
                                        Padding="4,1"
                                        Background="#E5211F1B"
                                        BorderBrush="#FF77BBA7"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <TextBlock Text="{Binding SlotLabel}"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Border>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType={x:Type views:HudOverlayView}}}"
                                                     Value="True">
                                            <Setter Property="Cursor" Value="SizeAll" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType={x:Type views:HudOverlayView}}}"
                                         Value="True">
                                <Setter TargetName="EditFrame" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Viewbox>
</UserControl>
