<UserControl x:Class="D4Hub.App.Views.HudOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:D4Hub.Core;assembly=D4Hub.Core"
             xmlns:views="clr-namespace:D4Hub.App.Views"
             x:Name="Root"
             IsHitTestVisible="{Binding IsEditing, ElementName=Root}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="Transparent">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HudSurfaceBrush"
                         Color="{StaticResource ColorSurface}"
                         Opacity="0.88" />
        <SolidColorBrush x:Key="HudEditSurfaceBrush"
                         Color="{StaticResource ColorSurfaceElevated}"
                         Opacity="0.72" />
        <SolidColorBrush x:Key="HudEditHoverBrush"
                         Color="{StaticResource ColorSuccess}"
                         Opacity="0.18" />

        <Style x:Key="HudRuleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-6"
                                BorderBrush="{StaticResource TextPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AffixText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCFD5DB" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF000000"
                                      BlurRadius="2.5"
                                      ShadowDepth="1"
                                      Opacity="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Core}">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Offensive}">
                    <Setter Property="Foreground" Value="#FFFF6B5F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Defensive}">
                    <Setter Property="Foreground" Value="#FF69B5FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Utility}">
                    <Setter Property="Foreground" Value="#FF8BE36B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Skill}">
                    <Setter Property="Foreground" Value="#FFFFD45C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueAffixText" TargetType="TextBlock" BasedOn="{StaticResource AffixText}">
            <Setter Property="FontSize" Value="9.75" />
        </Style>

        <Style x:Key="AffixGlowText" TargetType="TextBlock" BasedOn="{StaticResource AffixText}">
            <Setter Property="Opacity" Value="0.88" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFCFD5DB"
                                      BlurRadius="8"
                                      ShadowDepth="0"
                                      Opacity="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Core}">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Offensive}">
                    <Setter Property="Foreground" Value="#FFFF6B5F" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFF5A4E" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Defensive}">
                    <Setter Property="Foreground" Value="#FF69B5FF" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF3A9DFF" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Utility}">
                    <Setter Property="Foreground" Value="#FF8BE36B" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF68D43D" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorKind}" Value="{x:Static core:HudAffixColorKind.Skill}">
                    <Setter Property="Foreground" Value="#FFFFD45C" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFFBF2F" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueAffixGlowText" TargetType="TextBlock" BasedOn="{StaticResource AffixGlowText}">
            <Setter Property="FontSize" Value="9.75" />
        </Style>

        <Style x:Key="AffixSourceBadge" TargetType="Border">
            <Setter Property="Height" Value="12" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AffixSourceBadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="7.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="AffixSourceIcon" TargetType="Image">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform"
             StretchDirection="Both"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
        <Canvas x:Name="DesignCanvas"
                Width="695"
                Height="1060"
                Background="Transparent"
                ClipToBounds="True"
                MouseMove="DesignCanvas_MouseMove"
                MouseLeftButtonUp="DesignCanvas_MouseLeftButtonUp"
                LostMouseCapture="DesignCanvas_LostMouseCapture">
            <Border x:Name="ProfileHeader"
                    Canvas.Left="238"
                    Canvas.Top="12"
                    Width="277"
                    Height="32"
                    Background="{StaticResource HudSurfaceBrush}"
                    BorderBrush="{StaticResource SuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProfileName, ElementName=Root}"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="EditingIndicator"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEditing, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Ellipse Width="5"
                                 Height="5"
                                 Margin="0,0,4,0"
                                 Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Text="调整中"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Rules, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="695" Height="1060" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding AnchorX}" />
                        <Setter Property="Canvas.Top" Value="{Binding AnchorY}" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="RuleRoot"
                              Width="{Binding DisplayWidth}"
                              Background="Transparent"
                              AutomationProperties.Name="{Binding SlotLabel, StringFormat={}{0} 词缀位置}"
                              FocusVisualStyle="{StaticResource HudRuleFocusVisual}"
                              MouseLeftButtonDown="Rule_MouseLeftButtonDown"
                              PreviewKeyDown="Rule_PreviewKeyDown">
                            <ItemsControl ItemsSource="{Binding DisplayLines}"
                                          Width="{Binding DisplayWidth}"
                                          ClipToBounds="True"
                                          IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding DataContext.DisplayWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                          Height="14"
                                          ClipToBounds="True"
                                          SnapsToDevicePixels="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel x:Name="CompactSourceMarkers"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Image Source="/D4Hub;component/Assets/Hud/marker-tempered.png"
                                                   Style="{StaticResource AffixSourceIcon}"
                                                   Visibility="{Binding IsTempered, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Image Source="/D4Hub;component/Assets/Hud/marker-masterworked.png"
                                                   Style="{StaticResource AffixSourceIcon}"
                                                   Visibility="{Binding IsMasterworked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Image Source="/D4Hub;component/Assets/Hud/marker-transfigured.png"
                                                   Style="{StaticResource AffixSourceIcon}"
                                                   Visibility="{Binding IsTransfigured, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel x:Name="ValueSourceBadges"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                            <Border Style="{StaticResource AffixSourceBadge}"
                                                    Background="#B23B2713"
                                                    BorderBrush="#FFFFB454"
                                                    Visibility="{Binding IsTempered, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="回火"
                                                           Foreground="#FFFFC779"
                                                           Style="{StaticResource AffixSourceBadgeText}" />
                                            </Border>
                                            <Border Style="{StaticResource AffixSourceBadge}"
                                                    Background="#B231183C"
                                                    BorderBrush="#FFD6A5FF"
                                                    Visibility="{Binding IsMasterworked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="精造"
                                                           Foreground="#FFE2C2FF"
                                                           Style="{StaticResource AffixSourceBadgeText}" />
                                            </Border>
                                            <Border Style="{StaticResource AffixSourceBadge}"
                                                    Background="#B2103837"
                                                    BorderBrush="#FF5CE1D1"
                                                    Visibility="{Binding IsTransfigured, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="嬗变"
                                                           Foreground="#FF82F2E5"
                                                           Style="{StaticResource AffixSourceBadgeText}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="CompactGlow"
                                                   Grid.Column="0"
                                                   Text="{Binding CompactText}"
                                                   TextAlignment="Left"
                                                   Style="{StaticResource AffixGlowText}" />
                                        <TextBlock x:Name="CompactText"
                                                   Grid.Column="0"
                                                   Text="{Binding CompactText}"
                                                   TextAlignment="Left"
                                                   Style="{StaticResource AffixText}" />
                                        <TextBlock x:Name="ValueGlow"
                                                   Grid.Column="0"
                                                   Text="{Binding ValueText}"
                                                   TextAlignment="Left"
                                                   Style="{StaticResource ValueAffixGlowText}"
                                                   Visibility="Collapsed" />
                                        <TextBlock x:Name="ValueText"
                                                   Grid.Column="0"
                                                   Text="{Binding ValueText}"
                                                   TextAlignment="Left"
                                                   Style="{StaticResource ValueAffixText}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type views:HudOverlayView}}}"
                                                     Value="{x:Static core:HudDisplayMode.Values}">
                                            <Setter TargetName="CompactSourceMarkers" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ValueSourceBadges" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="CompactText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="CompactGlow" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ValueText" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ValueGlow" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="EditFrame"
                                    Margin="-5"
                                    Background="{StaticResource HudEditSurfaceBrush}"
                                    BorderBrush="{StaticResource SuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        MaxWidth="96"
                                        Margin="0"
                                        Padding="4,1"
                                        Background="{StaticResource SurfaceElevatedBrush}"
                                        CornerRadius="0,3,0,3">
                                    <TextBlock Text="{Binding SlotLabel}"
                                               Foreground="White"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Border>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType={x:Type views:HudOverlayView}}}"
                                                     Value="True">
                                            <Setter Property="Cursor" Value="SizeAll" />
                                            <Setter Property="Focusable" Value="True" />
                                            <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType={x:Type views:HudOverlayView}}}"
                                         Value="True">
                                <Setter TargetName="EditFrame" Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EditFrame"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType={x:Type views:HudOverlayView}}}"
                                               Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=RuleRoot}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="EditFrame" Property="Background" Value="{StaticResource HudEditHoverBrush}" />
                                <Setter TargetName="EditFrame" Property="BorderThickness" Value="2" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Viewbox>
</UserControl>
