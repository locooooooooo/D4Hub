<Window x:Class="D4Hub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:D4Hub.App.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DHub · 个人工作台"
        Width="1420"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Opacity="0"
        Background="{StaticResource AppBackgroundBrush}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="68"
                          ResizeBorderThickness="7"
                          GlassFrameThickness="0"
                          CornerRadius="0"
                          UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Border x:Name="WindowFrame"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1"
            Background="{StaticResource AppBackgroundBrush}">
    <Grid x:Name="RootGrid"
          Background="{StaticResource AppBackgroundBrush}"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform X="0" Y="14" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- 氛围光晕背景 -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Ellipse Width="640"
                     Height="430"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-150,-170,0"
                     Fill="{StaticResource AmbientGlowBrush}" />
            <Ellipse Width="500"
                     Height="400"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-160,0,0,-140"
                     Fill="{StaticResource AmbientGlowCoolBrush}" />
        </Grid>

        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.28" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False">
                    <views:BrandMark Width="40" Height="40" Margin="0,0,11,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DHub"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WorkspaceSubtitle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton"
                            Style="{StaticResource BaseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="检查并安装 DHub 更新"
                            Click="UpdateButton_Click"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE896;" Margin="0,0,7,0" />
                            <TextBlock x:Name="UpdateButtonText" Text="检查更新" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BaseButton}"
                            Command="{Binding ImportCommand}"
                            Visibility="{Binding IsHudPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="导入 BD 库"
                            Margin="0,0,8,0">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8B5;" />
                    </Button>
                    <Button Style="{StaticResource BaseButton}"
                            Command="{Binding ExportCommand}"
                            Visibility="{Binding IsHudPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="导出 BD 库"
                            Margin="0,0,8,0">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xEDE1;" />
                    </Button>
                    <Button Style="{StaticResource BaseButton}"
                            Command="{Binding LoadScreenshotCommand}"
                            Visibility="{Binding IsHudPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="从截图采集 BD 指纹并预览 HUD"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE91B;" Margin="0,0,7,0" />
                            <TextBlock Text="截图采集" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BaseButton}"
                            Command="{Binding CaptureFingerprintCommand}"
                            Visibility="{Binding IsHudPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="从当前游戏画面采集所选 BD 指纹"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE722;" Margin="0,0,7,0" />
                            <TextBlock Text="游戏采集" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleTrackingCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="开始或暂停角色面板监测（快捷键 F2）">
                        <Button.Effect>
                            <DropShadowEffect Color="{StaticResource ColorAccent}"
                                              BlurRadius="20"
                                              ShadowDepth="0"
                                              Opacity="0" />
                        </Button.Effect>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTracking}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                     From="0.16"
                                                                     To="0.5"
                                                                     Duration="0:0:1.4"
                                                                     AutoReverse="True">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE7F4;" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding TrackingButtonText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                    <Border Width="1"
                            Height="24"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceHoverBrush}"
                            IsHitTestVisible="False" />
                    <Button Style="{StaticResource CaptionButton}"
                            Content="&#xE921;"
                            ToolTip="最小化"
                            Click="CaptionMinimize_Click" />
                    <Button Style="{StaticResource CaptionButton}"
                            ToolTip="最大化或还原"
                            Click="CaptionMaximizeRestore_Click">
                        <TextBlock x:Name="MaxRestoreGlyph" Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="关闭"
                            Click="CaptionClose_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <views:BrandMark Width="25" Height="25" Margin="0,0,8,0" />
                            <TextBlock Text="DHub" Style="{StaticResource SectionHeadingText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="PERSONAL WORKSPACE" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="1,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="功能" Style="{StaticResource CaptionText}" Margin="10,0,0,7" />
                        <RadioButton GroupName="HubNavigation"
                                     Style="{StaticResource HubNavigationItem}"
                                     IsChecked="{Binding IsOverviewPage, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE80F;" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="概览" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="HubNavigation"
                                     Style="{StaticResource HubNavigationItem}"
                                     IsChecked="{Binding IsHudPage, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE7F4;" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="HUD 叠层" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="HubNavigation"
                                     Style="{StaticResource HubNavigationItem}"
                                     IsChecked="{Binding IsLootFiltersPage, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE71D;" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="战利品过滤器" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ResourcesNavigation"
                                     GroupName="HubNavigation"
                                     Style="{StaticResource HubNavigationItem}"
                                     IsChecked="{Binding IsResourcesPage, Mode=TwoWay}"
                                     Checked="ResourcesNavigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE707;" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="地图工具" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="规划中" Style="{StaticResource CaptionText}" Margin="10,15,0,7" />
                        <RadioButton Style="{StaticResource HubNavigationItem}" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8B7;" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="构筑资料" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HubNavigationItem}" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE7C3;" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="会话记录" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Border Grid.Row="4"
                            Background="#17243732"
                            BorderBrush="#4A77BBA7"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource PulseDot}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="本地模式" FontWeight="SemiBold" FontSize="11" />
                                <TextBlock Text="可见画面识别" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="{Binding IsHudPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHudPage}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="BD 库" Style="{StaticResource SectionHeadingText}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}"
                                    Command="{Binding AddProfileCommand}"
                                    Content="&#xE710;"
                                    ToolTip="新建 BD" />
                            <Button Style="{StaticResource IconButton}"
                                    Command="{Binding RemoveProfileCommand}"
                                    Content="&#xE74D;"
                                    ToolTip="删除所选 BD"
                                    Margin="5,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox ItemsSource="{Binding ClassFilters}"
                                  SelectedItem="{Binding SelectedClassFilter}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilterComboBox}"
                                  ToolTip="按职业筛选" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding SeasonFilters}"
                                  SelectedItem="{Binding SelectedSeasonFilter}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilterComboBox}"
                                  ToolTip="按赛季模式筛选" />
                        <ComboBox Grid.Row="2"
                                  ItemsSource="{Binding DifficultyFilters}"
                                  SelectedItem="{Binding SelectedDifficultyFilter}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilterComboBox}"
                                  ToolTip="按普通或专家模式筛选" />
                        <ComboBox Grid.Row="2" Grid.Column="2"
                                  ItemsSource="{Binding PurposeFilters}"
                                  SelectedItem="{Binding SelectedPurposeFilter}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilterComboBox}"
                                  ToolTip="按玩法用途筛选" />
                    </Grid>

                    <Grid Grid.Row="4">
                        <ListBox x:Name="ProfileList"
                                 ItemsSource="{Binding FilteredProfiles}"
                                 SelectedItem="{Binding SelectedProfile}"
                                 ItemContainerStyle="{StaticResource NavigationItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ClassName}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetadataSummary}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="9"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Margin="24">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=ProfileList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="22"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Opacity="0.55" />
                            <TextBlock Text="没有符合条件的 BD"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="调整筛选条件，或点击右上角新建"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="5">
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="2,14,2,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="自动贴附" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Document.Overlay.AutoAttach}"
                                              HorizontalAlignment="Right"
                                              ToolTip="检测到角色面板后自动显示 HUD" />
                                </Grid>
                                <TextBlock Text="面板置信度" Style="{StaticResource CaptionText}" />
                                <Slider Minimum="0.35"
                                        Maximum="0.95"
                                        Value="{Binding Document.Overlay.PanelConfidenceThreshold}"
                                        ToolTip="角色面板检测阈值" />
                                <TextBlock Text="BD 置信度" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                                <Slider Minimum="0.5"
                                        Maximum="0.95"
                                        Value="{Binding Document.Overlay.BuildConfidenceThreshold}"
                                        ToolTip="BD 指纹匹配阈值" />
                            </StackPanel>
                        </Border>
                        <Border Background="#17243732"
                                BorderBrush="#4A77BBA7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,12,0,0"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource PulseDot}" />
                                <TextBlock Grid.Column="1"
                                           Text="纯屏幕识别 · 点击穿透"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" />
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="10"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <StackPanel>
                                        <TextBlock Text="统计 HUD" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="游戏内叠层" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding RealtimePanel.ResetStatisticsCommand}"
                                            Content="&#xE777;"
                                            ToolTip="清零伤害统计" />
                                </Grid>

                                <Grid MinHeight="43">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE9D9;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="伤害统计" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RealtimePanel.StatusText}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="9" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsDamageStatisticsHudEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="在游戏中显示伤害统计 HUD" />
                                </Grid>

                                <Grid MinHeight="37" Margin="24,0,0,0">
                                    <TextBlock Text="紧凑显示" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding IsStatisticsHudCompact, Mode=TwoWay}"
                                              IsEnabled="{Binding IsDamageStatisticsHudEnabled}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              ToolTip="只显示 DPS 和最近 1 秒伤害" />
                                </Grid>

                                <Border Height="1" Margin="0,3" Background="{StaticResource HairlineBrush}" />

                                <Grid MinHeight="35" Opacity="0.55">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFontFamily}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="经验获取" FontSize="10" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" IsEnabled="False" VerticalAlignment="Center" ToolTip="尚未接入" />
                                </Grid>
                                 <Grid MinHeight="35">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="24" />
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>
                                     <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFontFamily}" VerticalAlignment="Center" />
                                     <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                         <TextBlock Text="材料/道具拾取" FontSize="10" />
                                         <TextBlock Text="{Binding RealtimePanel.MaterialPickupStatusText}"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    FontSize="9" />
                                     </StackPanel>
                                 </Grid>
                                <Grid MinHeight="35" Opacity="0.55">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFontFamily}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="钥匙获取" FontSize="10" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" IsEnabled="False" VerticalAlignment="Center" ToolTip="尚未接入" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <Grid Margin="24,20,24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="76" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" MinHeight="380" />
                    </Grid.RowDefinitions>

                    <ContentControl Style="{StaticResource AnimatedCard}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="205" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="暗黑核 BD 一键导入" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="公共库优先 · 只在缺失或刷新时联网"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                <TextBox Text="{Binding D2CoreUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextField}"
                                         VerticalContentAlignment="Center"
                                         ToolTip="粘贴 https://www.d2core.com/d4/planner?bd=...&amp;var=..." />
                                <TextBlock Text="{Binding D2CoreStatus}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           Margin="1,4,1,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding PasteD2CoreCommand}"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Top"
                                    ToolTip="读取剪贴板中的暗黑核链接并导入">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsD2CoreImporting}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="13"
                                          Height="13"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5"
                                          Visibility="{Binding IsD2CoreImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Grid.RenderTransform>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsD2CoreImporting}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0"
                                                                                     To="360"
                                                                                     Duration="0:0:0.9" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Ellipse Stroke="White"
                                                 StrokeThickness="1.6"
                                                 StrokeDashArray="9 31"
                                                 StrokeStartLineCap="Round"
                                                 StrokeEndLineCap="Round" />
                                    </Grid>
                                    <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE77F;" Margin="0,0,6,0" />
                                    <TextBlock Text="粘贴并导入" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Style="{StaticResource BaseButton}"
                                    Command="{Binding ImportD2CoreCommand}"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Top"
                                    ToolTip="导入输入框中的暗黑核链接">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8B5;" />
                            </Button>
                            <Button Grid.Column="4"
                                    Style="{StaticResource BaseButton}"
                                    Command="{Binding RefreshD2CoreCommand}"
                                    VerticalAlignment="Top"
                                    ToolTip="忽略缓存，从暗黑核刷新当前链接">
                                <TextBlock x:Name="RefreshGlyph"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           Text="&#xE72C;"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RefreshGlyph"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 To="180"
                                                                 Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RefreshGlyph"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 To="0"
                                                                 Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </ContentControl>

                    <UniformGrid Grid.Row="2" Columns="3">
                        <ContentControl Style="{StaticResource AnimatedCard}" Margin="0,0,8,0" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="游戏窗口" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding GameStatus}" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ContentControl>
                        <ContentControl Style="{StaticResource AnimatedCard}" Margin="4,0" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="角色面板" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding PanelStatus}" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ContentControl>
                        <ContentControl Style="{StaticResource AnimatedCard}" Margin="8,0,0,0" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="当前 BD" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding RecognitionStatus}" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ContentControl>
                    </UniformGrid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BD 名称" Style="{StaticResource CaptionText}" Margin="1,0,0,5" />
                            <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}"
                                     FontSize="16"
                                     FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="职业" Style="{StaticResource CaptionText}" Margin="1,0,0,5" />
                            <TextBox Text="{Binding SelectedProfile.ClassName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="变体" Style="{StaticResource CaptionText}" Margin="1,0,0,5" />
                            <TextBox Text="{Binding SelectedProfile.Variant, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="装备槽" Style="{StaticResource SectionHeadingText}" Margin="0,0,0,9" />
                            <Grid>
                                <ListBox x:Name="RuleList"
                                         ItemsSource="{Binding SelectedProfile.EquipmentRules}"
                                         SelectedItem="{Binding SelectedRule}"
                                         ItemContainerStyle="{StaticResource NavigationItem}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.CanContentScroll="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SlotLabel}" FontWeight="SemiBold" />
                                                <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="选择或新建 BD 后配置装备槽"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,26,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=RuleList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="词缀规则" Style="{StaticResource SectionHeadingText}" />
                                <CheckBox IsChecked="{Binding SelectedRule.IsEnabled}"
                                          Content="显示"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="装备槽名称" Style="{StaticResource CaptionText}" Margin="1,0,0,5" />
                            <TextBox Text="{Binding SelectedRule.SlotLabel, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}"
                                     Margin="0,0,0,12" />
                            <TextBlock Text="装备名称" Style="{StaticResource CaptionText}" Margin="1,0,0,5" />
                            <TextBox Text="{Binding SelectedRule.ItemName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}"
                                     Margin="0,0,0,12" />
                            <TextBlock Text="必要词缀" Style="{StaticResource CaptionText}" Margin="1,0,0,5" />
                            <TextBox Text="{Binding SelectedRule.MandatoryText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="78"
                                     VerticalContentAlignment="Top"
                                     Margin="0,0,0,12" />
                            <TextBlock Text="备选词缀" Style="{StaticResource CaptionText}" Margin="1,0,0,5" />
                            <TextBox Text="{Binding SelectedRule.OptionalText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="68"
                                     VerticalContentAlignment="Top" />
                            <Grid Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="BD 视觉指纹" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding FingerprintStatus}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <ProgressBar Style="{StaticResource ThinProgressBar}"
                                             Width="130"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             views:ProgressBarSmoother.SmoothValue="{Binding RecognitionConfidence, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="角色面板 HUD"
                                           Style="{StaticResource SectionHeadingText}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource BaseButton}"
                                            Command="{Binding BeginLayoutEditingCommand}"
                                            MinHeight="32"
                                            Padding="10,0"
                                            Margin="0,0,8,0"
                                            ToolTip="按当前 BD 与游戏分辨率校准 HUD 位置">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFontFamily}"
                                                       Text="&#xE7C8;"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="调整位置" />
                                        </StackPanel>
                                    </Button>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="简略"
                                                         GroupName="HudDisplayMode"
                                                         Style="{StaticResource HudModeSegmentButton}"
                                                         IsChecked="{Binding IsCompactHudMode, Mode=TwoWay}" />
                                            <RadioButton Content="数值"
                                                         GroupName="HudDisplayMode"
                                                         Style="{StaticResource HudModeSegmentButton}"
                                                         IsChecked="{Binding IsValuesHudMode, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Background="#FF0C0C0B"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="7">
                                <Viewbox Height="410" Stretch="Uniform">
                                    <views:HudOverlayView Width="695"
                                                          Height="1060"
                                                          ProfileName="{Binding SelectedProfile.Name}"
                                                          Rules="{Binding SelectedProfile.EquipmentRules}"
                                                          DisplayMode="{Binding HudDisplayMode}" />
                                </Viewbox>
                            </Border>
                            <Grid Margin="1,8,1,0">
                                <TextBlock Text="{Binding LayoutStatus}"
                                           Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding LayoutResolutionLabel}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionText}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

            <Grid Grid.Column="1"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="{Binding IsResourcesPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsResourcesPage}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="24,0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding HelltidesResource.DisplayName}"
                                           Style="{StaticResource SectionHeadingText}"
                                           VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="4"
                                        Padding="7,3"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="第三方社区"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding HelltidesResource.HostName}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                <TextBlock Text="{Binding HelltidesResource.ReviewLabel}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}"
                                    Click="ReloadHelltides_Click"
                                    Content="&#xE72C;"
                                    ToolTip="刷新地图" />
                            <Button Style="{StaticResource IconButton}"
                                    Click="OpenHelltidesInBrowser_Click"
                                    Content="&#xE8A7;"
                                    ToolTip="在系统浏览器打开"
                                    Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#181C2523"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}"
                                       Text="&#xE72E;"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding HelltidesResource.RiskNotes}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="HelltidesPrivacyStatusText"
                                   Grid.Column="1"
                                   Text="隐私模式 · 地图打开后启用"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="18,0,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 开荒地图 HUD 设置面板（P1）：控制面板 + 本地数据配置 -->
                    <Border Grid.Column="0"
                            Background="{StaticResource AppBackgroundBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                            <StackPanel Margin="18,14,18,20">
                                <Grid Margin="0,0,0,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFontFamily}"
                                                       Text="&#xE707;"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="14"
                                                       Margin="0,0,7,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="开荒地图 HUD"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="本地底图 · 社区 POI · 日程推算"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsMapHudEnabled, Mode=TwoWay}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              ToolTip="在游戏内显示开荒地图 HUD（置顶透明点击穿透）" />
                                </Grid>

                                <Border Height="1" Margin="0,2,0,12" Background="{StaticResource HairlineBrush}" />

                                <TextBlock Text="当前区域" Style="{StaticResource CaptionText}" Margin="1,0,0,4" />
                                <ComboBox SelectedValue="{Binding MapHudSettings.CurrentRegion, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          Style="{StaticResource FilterComboBox}"
                                          Margin="0,0,0,12"
                                          ToolTip="切换底图与对应 POI 数据集">
                                    <ComboBoxItem Content="干旱草原" Tag="dry_steppes" />
                                    <ComboBoxItem Content="碎峰岭" Tag="fractured_peaks" />
                                    <ComboBoxItem Content="斯科斯格伦" Tag="scosglenn" />
                                    <ComboBoxItem Content="哈维泽" Tag="hawezar" />
                                    <ComboBoxItem Content="凯基斯坦" Tag="kegistan" />
                                </ComboBox>

                                <TextBlock Text="显示内容" Style="{StaticResource CaptionText}" Margin="1,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding MapHudSettings.ShowChests, Mode=TwoWay}" Margin="0,3,0,3" ToolTip="种秘宝箱">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="◆" Foreground="#FFE74C3C" FontSize="9" VerticalAlignment="Center" />
                                                <TextBlock Text="种秘宝箱" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding MapHudSettings.ShowEliteChests, Mode=TwoWay}" Margin="0,3,0,3" ToolTip="精锐宝箱">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="◆" Foreground="#FFF39C12" FontSize="9" VerticalAlignment="Center" />
                                                <TextBlock Text="精锐宝箱" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding MapHudSettings.ShowEvents, Mode=TwoWay}" Margin="0,3,0,3" ToolTip="事件">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="◆" Foreground="#FF3498DB" FontSize="9" VerticalAlignment="Center" />
                                                <TextBlock Text="事件" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox IsChecked="{Binding MapHudSettings.ShowRituals, Mode=TwoWay}" Margin="0,3,0,3" ToolTip="仪式">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="◆" Foreground="#FF9B59B6" FontSize="9" VerticalAlignment="Center" />
                                                <TextBlock Text="仪式" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding MapHudSettings.ShowDungeons, Mode=TwoWay}" Margin="0,3,0,3" ToolTip="地城虫">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="◆" Foreground="#FF1ABC9C" FontSize="9" VerticalAlignment="Center" />
                                                <TextBlock Text="地城虫" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="地图透明度" Style="{StaticResource CaptionText}" Margin="1,0,0,4" />
                                <Slider Minimum="0.10"
                                        Maximum="1.0"
                                        Value="{Binding MapHudSettings.Opacity, Mode=TwoWay}"
                                        ToolTip="地图底图与标记的不透明度"
                                        Margin="0,0,0,12" />

                                <TextBlock Text="覆屏大小" Style="{StaticResource CaptionText}" Margin="1,0,0,4" />
                                <Slider Minimum="0.50"
                                        Maximum="2.0"
                                        Value="{Binding MapHudSettings.OverlayScale, Mode=TwoWay}"
                                        ToolTip="HUD 整体缩放系数"
                                        Margin="0,0,0,12" />

                                <TextBlock Text="计时条背景宽度（0=透明）" Style="{StaticResource CaptionText}" Margin="1,0,0,4" />
                                <Slider Minimum="0.0"
                                        Maximum="1.0"
                                        Value="{Binding MapHudSettings.TimerBarBackgroundWidth, Mode=TwoWay}"
                                        ToolTip="计时条背景不透明度"
                                        Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                    <TextBlock Text="计时条排列" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <RadioButton GroupName="MapTimerLayout"
                                                 Content="横排"
                                                 IsChecked="{Binding MapHudSettings.TimerBarHorizontal, Mode=TwoWay}"
                                                 VerticalAlignment="Center" />
                                    <RadioButton GroupName="MapTimerLayout"
                                                 Content="竖排"
                                                 IsChecked="{Binding MapTimerBarVertical, Mode=TwoWay}"
                                                 Margin="14,0,0,0"
                                                 VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="底图目录" Style="{StaticResource CaptionText}" Margin="1,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding MapHudSettings.MapImagePath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextField}"
                                             FontSize="11"
                                             ToolTip="每区域一张 {区域key}.png，如 dry_steppes.png" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource BaseButton}"
                                            Content="浏览"
                                            Padding="8,2"
                                            MinHeight="24"
                                            Margin="6,0,0,0"
                                            Click="MapImageBrowse_Click"
                                            ToolTip="选择底图目录" />
                                </Grid>

                                <TextBlock Text="社区 POI JSON" Style="{StaticResource CaptionText}" Margin="1,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding MapHudSettings.PoiDataPath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextField}"
                                             FontSize="11"
                                             ToolTip="社区 POI JSON（归一化坐标）" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource BaseButton}"
                                            Content="浏览"
                                            Padding="8,2"
                                            MinHeight="24"
                                            Margin="6,0,0,0"
                                            Click="PoiBrowse_Click"
                                            ToolTip="选择 POI JSON 文件" />
                                </Grid>

                                <TextBlock Text="日程偏移（秒）" Style="{StaticResource CaptionText}" Margin="1,0,0,4" />
                                <TextBox Text="{Binding MapHudSettings.ScheduleOffsetSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextField}"
                                         FontSize="11"
                                         ToolTip="世界事件日程整体平移：负值提前，正值延后" />

                                <TextBlock Text="声音设置" FontSize="10" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding MapHudSettings.AudioEnabled, Mode=TwoWay}"
                                              Content="音频提醒"
                                              VerticalAlignment="Center"
                                              ToolTip="世界事件开始时播放提醒；默认关闭，需显式开启" />
                                    <TextBlock Grid.Column="1"
                                               Text="音量"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center" />
                                    <Slider Grid.Column="3"
                                            Width="90"
                                            Minimum="0"
                                            Maximum="1"
                                            Value="{Binding MapHudSettings.AudioVolume, Mode=TwoWay}"
                                            ToolTip="提醒音量"
                                            VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Boss" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" ToolTip="世界 Boss 开始时播放" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MapHudSettings.AudioBossPath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextField}"
                                             FontSize="10"
                                             ToolTip="世界 Boss 开始时播放" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BaseButton}"
                                            Content="浏览"
                                            Tag="boss"
                                            Click="AudioBrowse_Click"
                                            Padding="8,2"
                                            MinHeight="22"
                                            FontSize="10"
                                            Margin="6,0,0,0" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="蓝" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" ToolTip="地狱狂潮开始时播放" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MapHudSettings.AudioElitePath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextField}"
                                             FontSize="10"
                                             ToolTip="地狱狂潮开始时播放" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BaseButton}"
                                            Content="浏览"
                                            Tag="elite"
                                            Click="AudioBrowse_Click"
                                            Padding="8,2"
                                            MinHeight="22"
                                            FontSize="10"
                                            Margin="6,0,0,0" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="蓝品" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" ToolTip="军团事件开始时播放" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MapHudSettings.AudioBluePath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextField}"
                                             FontSize="10"
                                             ToolTip="军团事件开始时播放" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BaseButton}"
                                            Content="浏览"
                                            Tag="blue"
                                            Click="AudioBrowse_Click"
                                            Padding="8,2"
                                            MinHeight="22"
                                            FontSize="10"
                                            Margin="6,0,0,0" />
                                </Grid>

                                <TextBlock Text="快捷键" FontSize="10" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="切换显隐" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding MapHudSettings.HotkeyToggle, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource FilterComboBox}"
                                              FontSize="10"
                                              ToolTip="显示/隐藏地图 HUD">
                                        <ComboBoxItem Content="~" Tag="Oem3" />
                                        <ComboBoxItem Content="F5" Tag="F5" />
                                        <ComboBoxItem Content="F6" Tag="F6" />
                                        <ComboBoxItem Content="F7" Tag="F7" />
                                        <ComboBoxItem Content="F8" Tag="F8" />
                                        <ComboBoxItem Content="无" Tag="None" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="重绘地图" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding MapHudSettings.HotkeyRedraw, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource FilterComboBox}"
                                              FontSize="10"
                                              ToolTip="重新加载底图与 POI">
                                        <ComboBoxItem Content="F5" Tag="F5" />
                                        <ComboBoxItem Content="F6" Tag="F6" />
                                        <ComboBoxItem Content="F7" Tag="F7" />
                                        <ComboBoxItem Content="F8" Tag="F8" />
                                        <ComboBoxItem Content="~" Tag="Oem3" />
                                        <ComboBoxItem Content="无" Tag="None" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="重置位置" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding MapHudSettings.HotkeyResetPlacement, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource FilterComboBox}"
                                              FontSize="10"
                                              ToolTip="按游戏窗口重新计算贴附位置">
                                        <ComboBoxItem Content="F6" Tag="F6" />
                                        <ComboBoxItem Content="F7" Tag="F7" />
                                        <ComboBoxItem Content="F8" Tag="F8" />
                                        <ComboBoxItem Content="F9" Tag="F9" />
                                        <ComboBoxItem Content="~" Tag="Oem3" />
                                        <ComboBoxItem Content="无" Tag="None" />
                                    </ComboBox>
                                </Grid>

                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="1,10,0,0"
                                           Text="底图与 POI 仅使用本地文件，禁止打包游戏资产；计时为日程推算，可手动偏移校准。" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1" Background="#FF0C0C0B">
                    <wv2:WebView2 x:Name="HelltidesWebView"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />

                    <Grid x:Name="HelltidesLoadingOverlay"
                          Panel.ZIndex="2"
                          Background="{StaticResource AppBackgroundBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                            <TextBlock Text="正在连接 Helltides.com"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="HelltidesErrorOverlay"
                            Panel.ZIndex="3"
                            Visibility="Collapsed"
                            Background="{StaticResource AppBackgroundBrush}">
                        <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}"
                                       Text="&#xE783;"
                                       FontSize="28"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="HelltidesErrorTitle"
                                       Text="地图暂时无法加载"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock x:Name="HelltidesErrorMessage"
                                       Text="请检查网络或 WebView2 Runtime。"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Click="RetryHelltides_Click"
                                        ToolTip="重新加载内嵌地图">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE72C;" Margin="0,0,7,0" />
                                        <TextBlock Text="重试" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BaseButton}"
                                        Click="OpenHelltidesInBrowser_Click"
                                        ToolTip="在系统浏览器打开"
                                        Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8A7;" Margin="0,0,7,0" />
                                        <TextBlock Text="浏览器打开" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Column="1"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="{Binding IsLootFiltersPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="24,0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="战利品过滤器" Style="{StaticResource SectionHeadingText}" />
                            <TextBlock Text="按职业、阶段和用途挑选可直接使用的 d2core 过滤码" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding LootFilters.FilterCountText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#181C2523"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,0">
                    <TextBlock Text="{Binding LootFilters.Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource AppBackgroundBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid Margin="18,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="过滤器集合" Style="{StaticResource SectionHeadingText}" />
                            <TextBox Grid.Row="1"
                                     Text="{Binding LootFilters.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}"
                                     Margin="0,12,0,10"
                                     ToolTip="搜索 BD 名称、过滤器、阶段、用途或 BD ID" />
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding LootFilters.ClassFilters}"
                                          SelectedItem="{Binding LootFilters.SelectedClass}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilterComboBox}"
                                          ToolTip="按职业筛选" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding LootFilters.StageFilters}"
                                          SelectedItem="{Binding LootFilters.SelectedStage}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilterComboBox}"
                                          ToolTip="按阶段筛选" />
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding LootFilters.UseCaseFilters}"
                                          SelectedItem="{Binding LootFilters.SelectedUseCase}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilterComboBox}"
                                          ToolTip="按用途筛选，例如开荒、速刷、冲层" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding LootFilters.SortFilters}"
                                          SelectedItem="{Binding LootFilters.SelectedSort}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilterComboBox}"
                                          ToolTip="调整过滤器排序" />
                            </Grid>
                            <Grid Grid.Row="4">
                                <ListBox ItemsSource="{Binding LootFilters.FilteredFilters}"
                                         SelectedItem="{Binding LootFilters.SelectedFilter}"
                                         ItemContainerStyle="{StaticResource NavigationItem}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.CanContentScroll="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding BuildDisplayName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ClassLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                                <TextBlock Text="{Binding StageUseCaseLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Margin="8,24,8,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LootFilters.HasFilteredFilters}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding LootFilters.EmptyFilterText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                        <StackPanel Margin="26,20,30,28">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding LootFilters.SelectedFilter.Name, FallbackValue=未选择过滤器}" Style="{StaticResource HeadingText}" />
                                    <TextBlock Text="{Binding LootFilters.SelectedFilterBuildLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding LootFilters.SelectedFilterSourceLabel}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Border Background="#242B36" CornerRadius="3" Padding="8,4" Margin="0,0,6,5">
                                            <TextBlock Text="{Binding LootFilters.SelectedFilterRecommendationLabel}" Foreground="#F2C15B" FontSize="10" />
                                        </Border>
                                        <Border Background="#242B36" CornerRadius="3" Padding="8,4" Margin="0,0,6,5">
                                            <TextBlock Text="{Binding LootFilters.SelectedFilterScopeLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                        </Border>
                                        <Border Background="#242B36" CornerRadius="3" Padding="8,4" Margin="0,0,6,5">
                                            <TextBlock Text="{Binding LootFilters.SelectedFilterUseCaseLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding LootFilters.SelectedFilter.Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding LootFilters.SelectedFilterFreshnessLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Command="{Binding LootFilters.CopySelectedCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTip="复制当前过滤码">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8C8;" Margin="0,0,7,0" />
                                        <TextBlock Text="复制过滤码" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ContentControl Style="{StaticResource AnimatedCard}" Padding="16,14" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="颜色规则" Style="{StaticResource SectionHeadingText}" />
                                    <ItemsControl ItemsSource="{Binding LootFilters.SelectedFilterLegend}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,12,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" Margin="4,0,7,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ContentControl>

                            <TextBlock Text="过滤码" Style="{StaticResource SectionHeadingText}" Margin="0,22,0,8" />
                            <TextBox Text="{Binding LootFilters.SelectedFilterCode, Mode=OneWay}"
                                     Style="{StaticResource TextField}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="112"
                                     MaxHeight="180"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     ToolTip="来自 d2core 页面复制按钮的原始过滤码" />

                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="导入到本地集合" Style="{StaticResource SectionHeadingText}" />
                                <Button Grid.Column="2"
                                        Command="{Binding LootFilters.ClearImportCommand}"
                                        Style="{StaticResource BaseButton}"
                                        HorizontalAlignment="Right"
                                        Padding="10,4"
                                        ToolTip="清空导入表单">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE777;" Margin="0,0,6,0" />
                                        <TextBlock Text="清空" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LootFilters.ImportName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}" ToolTip="过滤器名称" />
                                <TextBox Grid.Column="2" Text="{Binding LootFilters.ImportClassName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}" ToolTip="职业，例如 Druid" />
                                <ComboBox Grid.Column="4" ItemsSource="{Binding LootFilters.ImportStages}" SelectedItem="{Binding LootFilters.ImportStage}" DisplayMemberPath="Label" Style="{StaticResource FilterComboBox}" ToolTip="过滤器阶段" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LootFilters.ImportSourceUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}" ToolTip="来源页面链接，可选" />
                                <TextBox Grid.Column="2" Text="{Binding LootFilters.ImportBuildId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}" ToolTip="BD ID，可选" />
                            </Grid>
                            <TextBox Text="{Binding LootFilters.ImportDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}" Margin="0,10,0,0" ToolTip="备注，可选" />
                            <TextBox Text="{Binding LootFilters.ImportCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextField}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="88"
                                     MaxHeight="150"
                                     Margin="0,10,0,0"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     ToolTip="粘贴 d2core 页面复制出的完整过滤码" />
                            <Button Command="{Binding LootFilters.ImportCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    ToolTip="校验并写入本地过滤器集合">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8B5;" Margin="0,0,7,0" />
                                    <TextBlock Text="保存到本地集合" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid Grid.Column="1"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="{Binding IsOverviewPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverviewPage}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                    <Grid Margin="34,30,34,28" MaxWidth="1120" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="96" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="概览" Style="{StaticResource HeadingText}" />
                                <TextBlock Text="识别战局，走出自己的路。" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource PulseDot}" Width="7" Height="7" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding TrackingStatusText}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Grid>

                        <ContentControl Grid.Row="2" Style="{StaticResource AccentCard}" Padding="17,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <views:BrandMark Width="40" Height="40" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="关注 loco，加入玩家群" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CommunityStatus}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CopyDouyinHandleCommand}"
                                        Margin="14,0,8,0"
                                        ToolTip="复制抖音号 @loco">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="抖音 @loco" />
                                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8C8;" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3"
                                        Style="{StaticResource BaseButton}"
                                        Command="{Binding CopyCommunityGroupCommand}"
                                        ToolTip="复制 QQ 群号 736495487">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="QQ群 736495487" />
                                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE8C8;" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </ContentControl>

                        <UniformGrid Grid.Row="4" Columns="3">
                            <ContentControl Style="{StaticResource AnimatedCard}" Margin="0,0,8,0" Padding="15,13">
                                <StackPanel>
                                    <TextBlock Text="游戏窗口" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding GameStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource AnimatedCard}" Margin="4,0" Padding="15,13">
                                <StackPanel>
                                    <TextBlock Text="识别状态" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding RecognitionStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource AnimatedCard}" Margin="8,0,0,0" Padding="15,13">
                                <StackPanel>
                                    <TextBlock Text="构筑配置" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding ProfileCountText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" />
                                </StackPanel>
                            </ContentControl>
                        </UniformGrid>

                        <TextBlock Grid.Row="6" Text="已接入功能" Style="{StaticResource SectionHeadingText}" />

                        <ContentControl Grid.Row="8" Style="{StaticResource AnimatedCard}" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" Background="{StaticResource AccentSoftBrush}" CornerRadius="7" VerticalAlignment="Top">
                                    <TextBlock FontFamily="{StaticResource IconFontFamily}"
                                               Text="&#xE7F4;"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="HUD 叠层" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PanelStatus}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedProfileSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Command="{Binding OpenHudWorkspaceCommand}"
                                            ToolTip="打开 HUD 工作台">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="打开" />
                                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE72A;" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource PulseDot}" Margin="0,0,7,0" />
                    <TextBlock Text="DHub · 本地画面识别" Style="{StaticResource CaptionText}" />
                    <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding SelectedProfileSummary}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock x:Name="UpdateStatusText"
                               Text="更新服务就绪"
                               Margin="0,0,16,0"
                               Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding FingerprintStatus}"
                               Style="{StaticResource CaptionText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
