<Window x:Class="D4Hub.App.StatisticsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DHub 战斗统计"
        Width="320"
        Height="310"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Background="Transparent"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="StatisticsHudSurfaceBrush" Color="#E6191917" />
        <SolidColorBrush x:Key="StatisticsHudBorderBrush" Color="#B57A6855" />
        <SolidColorBrush x:Key="StatisticsHudAccentBrush" Color="#FFE26045" />
        <SolidColorBrush x:Key="StatisticsHudValueBrush" Color="#FFF7E7C3" />
        <SolidColorBrush x:Key="StatisticsHudMutedBrush" Color="#FF7A7165" />
        <Style x:Key="StatisticsHudLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#FFB9B5AD" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="StatisticsHudValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource StatisticsHudValueBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="StatisticsHudSection" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource StatisticsHudMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="ExpandedHud"
                Width="320"
                Height="310"
                Padding="12,9"
                Background="{StaticResource StatisticsHudSurfaceBrush}"
                BorderBrush="{StaticResource StatisticsHudBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatisticsHudCompact}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="14" Margin="0,0,7,0" Background="{StaticResource StatisticsHudAccentBrush}" CornerRadius="1" />
                    <TextBlock Grid.Column="1" Text="伤害统计" Foreground="White" FontFamily="{StaticResource AppFontFamily}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Margin="0,0,5,0" Fill="{StaticResource StatisticsHudAccentBrush}" />
                        <TextBlock Text="{Binding RealtimePanel.StatusText}" Style="{StaticResource StatisticsHudLabel}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="当前伤害段 DPS" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.DpsText}" Style="{StaticResource StatisticsHudValue}" FontSize="24" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="最近 1 秒" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.RecentOneSecondDamageText}" Style="{StaticResource StatisticsHudValue}" FontSize="15" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="#4D8A7D6F" />
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="1 秒峰值" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.PeakOneSecondDamageText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                    <Border Grid.Column="1" Height="29" Background="#4D8A7D6F" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="累计伤害" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.TotalDamageText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                    <Border Grid.Column="3" Height="29" Background="#4D8A7D6F" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="最高伤害" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.MaximumHitText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="4" Background="#4D8A7D6F" />
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="全会话平均 DPS" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.SessionAverageDpsText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                    <Border Grid.Column="1" Height="22" Background="#4D8A7D6F" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="总运行时间" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.TotalRunTimeText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="城镇时间" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.TownTimeText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                    <Border Grid.Column="1" Height="22" Background="#4D8A7D6F" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="战斗时间" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.CombatTimeText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="城镇" Style="{StaticResource StatisticsHudSection}" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               Text="{Binding RealtimePanel.TownStateText}"
                               Style="{StaticResource StatisticsHudSection}"
                               Foreground="#FF8BE36B" />
                    <TextBlock Grid.Column="2"
                               Margin="16,0,0,0"
                               Text="战斗"
                               Style="{StaticResource StatisticsHudSection}" />
                    <TextBlock Grid.Column="3"
                               Margin="8,0,0,0"
                               Text="{Binding RealtimePanel.CombatStateText}"
                               Style="{StaticResource StatisticsHudSection}"
                               Foreground="#FFFF6B5F" />
                </Grid>
                <Grid Grid.Row="8">
                    <TextBlock Text="屏幕估算" Style="{StaticResource StatisticsHudLabel}" VerticalAlignment="Bottom" />
                    <TextBlock Text="{Binding RealtimePanel.DataQualityText}" Style="{StaticResource StatisticsHudLabel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
                <Border Grid.Row="9" Background="#4D8A7D6F" />
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="材料/道具" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.MaterialPickupTotalText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                    <Border Grid.Column="1" Height="24" Background="#4D8A7D6F" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="金币" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.GoldPickupTotalText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                    <Border Grid.Column="3" Height="24" Background="#4D8A7D6F" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="材料/分" Style="{StaticResource StatisticsHudLabel}" />
                        <TextBlock Text="{Binding RealtimePanel.MaterialPickupPerMinuteText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="11"
                           Text="{Binding RealtimePanel.MaterialPickupStatusText}"
                           Style="{StaticResource StatisticsHudLabel}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border x:Name="CompactHud"
                Width="320"
                Height="64"
                Padding="12,8"
                VerticalAlignment="Top"
                Background="{StaticResource StatisticsHudSurfaceBrush}"
                BorderBrush="{StaticResource StatisticsHudBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatisticsHudCompact}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="3" Height="30" Margin="0,0,9,0" Background="{StaticResource StatisticsHudAccentBrush}" CornerRadius="1" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="当前 DPS" Style="{StaticResource StatisticsHudLabel}" />
                    <TextBlock Text="{Binding RealtimePanel.DpsText}" Style="{StaticResource StatisticsHudValue}" FontSize="20" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="最近 1 秒" Style="{StaticResource StatisticsHudLabel}" />
                    <TextBlock Text="{Binding RealtimePanel.RecentOneSecondDamageText}" Style="{StaticResource StatisticsHudValue}" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
