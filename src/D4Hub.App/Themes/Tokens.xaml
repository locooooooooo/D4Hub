<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorAppBackground">#FF11110F</Color>
    <Color x:Key="ColorSidebar">#FF161512</Color>
    <Color x:Key="ColorSurface">#FF211F1B</Color>
    <Color x:Key="ColorSurfaceElevated">#FF2A2722</Color>
    <Color x:Key="ColorSurfaceHover">#FF353027</Color>
    <Color x:Key="ColorTextPrimary">#FFF5EBD7</Color>
    <Color x:Key="ColorTextSecondary">#FFC6BAA5</Color>
    <Color x:Key="ColorTextMuted">#FF867C6C</Color>
    <Color x:Key="ColorBorder">#FF454037</Color>
    <Color x:Key="ColorAccent">#FFD45945</Color>
    <Color x:Key="ColorAccentPressed">#FFB73D31</Color>
    <Color x:Key="ColorSuccess">#FF77BBA7</Color>
    <Color x:Key="ColorWarning">#FFD8B35A</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorAppBackground}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource ColorSurfaceElevated}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
</ResourceDictionary>
