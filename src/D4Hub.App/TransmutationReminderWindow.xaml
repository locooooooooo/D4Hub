<Window x:Class="D4Hub.App.TransmutationReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D4Hub Transmutation Reminder"
        Width="272"
        Height="52"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent"
        Topmost="True"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Border Margin="1"
            Padding="8"
            Background="#F215191E"
            BorderBrush="#B3D7B86A"
            BorderThickness="1"
            CornerRadius="6">
        <ItemsControl ItemsSource="{Binding TransmutationReminders}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="5" Height="5" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF82D9C8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="回火">
                                            <Setter Property="Fill" Value="#FFFFB454" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="精造">
                                            <Setter Property="Fill" Value="#FFD6A5FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="打孔">
                                            <Setter Property="Fill" Value="#FF69B5FF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFB6F1E6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="回火">
                                            <Setter Property="Foreground" Value="#FFFFCE8A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="精造">
                                            <Setter Property="Foreground" Value="#FFE5C9FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="打孔">
                                            <Setter Property="Foreground" Value="#FF9FD0FF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
